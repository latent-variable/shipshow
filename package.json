{
  "name": "shipshow",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a shit show into a ship show: narrated explainer videos that help you understand a code base fast enough to ship it. Kokoro voice, HyperFrames scenes, rendered on your own machine.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node bin/setup.mjs",
    "setup:omnivoice": "[ -x .venv/bin/pip ] || npm run setup && .venv/bin/pip install -r requirements-omnivoice.txt -r requirements-hearback.txt",
    "setup:hearback": "[ -x .venv/bin/pip ] || npm run setup && .venv/bin/pip install -r requirements-hearback.txt",
    "doctor": "node bin/doctor.mjs",
    "new": "node bin/new.mjs",
    "voice": "node bin/voice.mjs",
    "build": "node bin/build.mjs",
    "check": "hyperframes check",
    "preview": "hyperframes preview",
    "render": "node bin/render.mjs",
    "make": "node bin/make.mjs",
    "review": "node bin/review.mjs",
    "usage": "node bin/usage.mjs",
    "critics": "node bin/critics.mjs",
    "skills": "node bin/link-skills.mjs",
    "test": "node --test test/*.test.mjs",
    "postinstall": "node bin/link-skills.mjs",
    "audit:deps": "bash scripts/audit-deps.sh",
    "audit:code": "bash scripts/audit-code.sh"
  },
  "devDependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.8.168"
  }
}
